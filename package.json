{
  "name": "drakonsk-landing",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "seo:generate": "node scripts/generate-seo-static.mjs",
    "prebuild": "yarn seo:generate",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:fsd": "steiger ./src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "check": "yarn lint && yarn lint:fsd && yarn typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.2",
    "i18next": "^25.5.2",
    "lottie-react": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-i18next": "^15.7.3",
    "react-router-dom": "^7.9.1",
    "zustand": "^5.0.8"
  },
  "resolutions": {
    "vite": "^6.4.6",
    "vitest/vite": "^6.4.6",
    "vite-node/vite": "^6.4.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@feature-sliced/steiger-plugin": "^0.5.6",
    "@playwright/test": "^1.55.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "steiger": "^0.5.11",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
